{
  "name": "artisanal-chocolate-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:init": "npm --prefix server run db:init"
  }
}
